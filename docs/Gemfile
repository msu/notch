source "https://rubygems.org"

# Deployed via GitHub Actions (not legacy branch deploy), so we use plain
# Jekyll rather than the `github-pages` gem -- that gem forces safe mode
# and randomizes plugins_dir, which would block the custom Notch Rouge
# lexer in _plugins/.
gem "jekyll", "~> 4.3"
gem "webrick"

# Jekyll 4 defaults to jekyll-sass-converter 3.x (sass-embedded), whose
# native extension fails to build on the GitHub Actions runner. Pin to
# 2.x which uses the libsass-backed `sassc` gem instead.
gem "jekyll-sass-converter", "~> 2.0"

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows / JRuby timezone data
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", "~> 2.0"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
